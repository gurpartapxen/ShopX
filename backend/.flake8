[flake8]
max-line-length = 120

exclude =
    venv,
    .venv,
    __pycache__,
    .git,
    setup_db.py,
    gen_sig.py

# W503 — line break before binary operator (conflicts with PEP 8 update)
# E241 — multiple spaces after ':' or ',' (deliberate alignment style)
# E221 — multiple spaces before operator  (deliberate alignment style)
ignore = W503, E241, E221

per-file-ignores =
    config/settings.py: E501, E122
