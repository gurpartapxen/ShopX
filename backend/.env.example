# ══════════════════════════════════════════════════════════════════════════════
#  Copy this file to .env and fill in your real values
#  Never commit .env to GitHub — only commit .env.example
# ══════════════════════════════════════════════════════════════════════════════

# ── Django ────────────────────────────────────────────────────────────────────
# Generate a strong secret key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to False in production
DEBUG=True

# Comma-separated. Add your Railway domain here in production
ALLOWED_HOSTS=localhost,127.0.0.1


# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Get this from: Atlas dashboard → Connect → Drivers → Python
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/

# The name of your database inside Atlas
MONGO_DB_NAME=ecommerce_db


# ── CORS ──────────────────────────────────────────────────────────────────────
# The URL of your Next.js frontend
FRONTEND_URL=http://localhost:3000


# ─────────────────────────────────────────────────────────────────────────────
# These will be added in later phases:
#
# Phase 2 (Auth)
# JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
# JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
#
# Phase 4 (Images)
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
#
# Phase 5 (Payments)
# RAZORPAY_KEY_ID=your-key-id
# RAZORPAY_KEY_SECRET=your-key-secret
# ─────────────────────────────────────────────────────────────────────────────
